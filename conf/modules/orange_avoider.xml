<!DOCTYPE module SYSTEM "module.dtd">

<module name="orange_avoider" dir="orange_avoider">
  <doc>
    Merged green-follow + opticflow avoidance arbiter.
  </doc>

  <header>
    <file name="orange_avoider.h"/>
  </header>

  <init fun="orange_avoider_init()"/>
  <periodic fun="orange_avoider_periodic()" freq="4"/>

  <settings>
    <dl_settings name="OrangeAvoider">
      <!-- Green follow tuning -->
      <dl_setting var="oa_green_roi_frac_threshold" min="0" step="0.01" max="1.0" shortname="green_thr"/>
      <dl_setting var="oa_search_yaw_increment_deg" min="0" step="1" max="45" shortname="yaw_inc"/>
      <dl_setting var="oa_forward_step_m" min="0" step="0.05" max="2.0" shortname="fwd_step"/>

      <!-- Orange detection tuning (fraction of ROI pixels) -->
      <dl_setting var="oa_color_count_frac" min="0" step="0.01" max="1.0" shortname="orange_thr"/>
    </dl_settings>
  </settings>

  <makefile>
    <file name="orange_avoider.c"/>
  </makefile>
</module>