<!DOCTYPE module SYSTEM "module.dtd">

<module name="orange_avoider" dir="orange_avoider">
  <doc>
    <description>
      Green-follow + opticflow avoidance arbiter.
    </description>
  </doc>

  <header>
    <file name="orange_avoider.h"/>
  </header>

  <init fun="orange_avoider_init()"/>
  <periodic fun="orange_avoider_periodic()" freq="4"/>

  <settings>
    <dl_settings name="OrangeAvoider">
      <!-- Greenfollow -->
      <dl_setting var="oa_green_roi_frac_threshold" min="0" step="0.01" max="1" shortname="green_thr"/>
      <dl_setting var="oa_tree_roi2_frac_threshold" min="0" step="0.01" max="1" shortname="top_thr"/>
      <dl_setting var="oa_search_yaw_increment_deg" min="0" step="1" max="45" shortname="yaw_inc"/>
      <dl_setting var="oa_forward_step_m" min="0" step="0.05" max="1.5" shortname="fwd_step"/>

      <!-- Opticflow -->
      <dl_setting var="oa_of_noise_max" min="0" step="0.05" max="2.0" shortname="of_noise"/>
      <dl_setting var="oa_of_div_thresh" min="0" step="0.005" max="1.0" shortname="of_div"/>
      <dl_setting var="oa_of_flow_mag_thresh" min="0" step="10" max="5000" shortname="of_mag"/>
      <dl_setting var="oa_of_close_min_speed_mps" min="0" step="0.01" max="1.0" shortname="of_vmin"/>
      <dl_setting var="oa_of_close_n" min="1" step="1" max="10" shortname="of_N"/>

      <dl_setting var="oa_of_avoid_time_s" min="0" step="0.1" max="5.0" shortname="of_time"/>
      <dl_setting var="oa_of_retreat_m" min="0" step="0.05" max="2.0" shortname="of_back"/>
      <dl_setting var="oa_of_turn_step_deg" min="0" step="1" max="30" shortname="of_turn"/>
      <dl_setting var="oa_of_goal_step_m" min="0" step="0.05" max="2.0" shortname="of_goal"/>
      <dl_setting var="oa_of_traj_step_m" min="0" step="0.05" max="3.0" shortname="of_traj"/>
    </dl_settings>
  </settings>

  <makefile>
    <file name="orange_avoider.c"/>
  </makefile>
</module>

